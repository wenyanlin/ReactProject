{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "paths": {
      "@org/shared-utils": ["./libs/shared/utils/src"],
      "@org/shared-ui": ["./libs/shared/ui/src"],
      "@org/comment": ["./libs/comment/src"],
      "@org/news": ["./libs/news/src"],
      "@org/auth": ["./libs/auth/src"],
      "@org/pages/react-project": ["./libs/pages/react-project/src"]
    }
  }
}
